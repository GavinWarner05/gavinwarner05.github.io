{
  "name": "nfl-sports-notifications",
  "private": true,
  "type": "module",
  "scripts": {
    "keys": "node scripts/generate-vapid-keys.mjs",
    "keys:install": "node scripts/generate-vapid-keys.mjs --install",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply sports-notifications --local",
    "db:migrate:remote": "wrangler d1 migrations apply sports-notifications --remote"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
