{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gavinwarner.digital/sports/data/schema.json",
  "title": "Public NFL Sports Center snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "display_timezone", "favorites", "games"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "display_timezone": { "const": "America/Los_Angeles" },
    "favorites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/teamId" } },
    "games": { "type": "array", "items": { "$ref": "#/$defs/game" } }
  },
  "$defs": {
    "teamId": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "abbreviation", "colors"],
      "properties": {
        "id": { "$ref": "#/$defs/teamId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "abbreviation": { "type": "string", "pattern": "^[A-Z]{2,4}$" },
        "record": { "type": "string", "maxLength": 20 },
        "logo_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "colors": {
          "type": "object", "additionalProperties": false, "required": ["primary", "secondary"],
          "properties": { "primary": { "$ref": "#/$defs/color" }, "secondary": { "$ref": "#/$defs/color" } }
        }
      }
    },
    "injury": {
      "type": "object", "additionalProperties": false, "required": ["team", "player", "status"],
      "properties": {
        "team": { "type": "string", "maxLength": 60 }, "player": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 40 }, "detail": { "type": "string", "maxLength": 160 }
      }
    },
    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kickoff", "status", "away_team", "home_team", "injuries"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,80}$" },
        "kickoff": { "type": "string", "format": "date-time" },
        "status": { "enum": ["scheduled", "pregame", "live", "halftime", "final", "postponed", "cancelled"] },
        "status_detail": { "type": "string", "maxLength": 40 },
        "week": { "type": ["integer", "null"], "minimum": 1, "maximum": 30 },
        "season_phase": { "type": "string", "maxLength": 40 },
        "away_team": { "$ref": "#/$defs/team" }, "home_team": { "$ref": "#/$defs/team" },
        "away_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 200 },
        "home_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 200 },
        "network": { "type": "string", "maxLength": 80 }, "venue": { "type": "string", "maxLength": 120 },
        "away_jersey": { "type": "string", "maxLength": 80 }, "home_jersey": { "type": "string", "maxLength": 80 },
        "injuries": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/injury" } },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
